# ============================================================
# Rabbit 网盘环境变量样例
# 复制为 .env 后按实际情况修改；.env 含敏感信息，禁止提交仓库！
# ============================================================

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=root
DB_NAME=rabbit_pan
DB_USER=rabbit
DB_PASSWORD=root

# ---------- Redis ----------
# 无需配置（仅容器内网访问，不设密码不暴露端口）

# ---------- MinIO ----------
MINIO_ACCESS_KEY=rabbitminio
MINIO_SECRET_KEY=RabbitMinio@2026
MINIO_BUCKET=rabbit-pan

# ---------- 业务密钥（必须修改，至少 32 字符随机串） ----------
# JWT 签名密钥：openssl rand -hex 32
JWT_SECRET=CHANGE-ME-to-a-random-64-char-hex-string-from-openssl-rand-hex-32
# 短链混淆盐值：openssl rand -hex 16
SHARE_SALT=aszx21qwedcv
# 首次启动初始化管理员 admin 的密码（登录后请立即修改）
ADMIN_PASSWORD=Admin@123456

# ---------- 对外访问 ----------
# 前端站点地址（后端 302 跳转与短链拼接用；生产改为你自己的域名）
FRONTEND_BASE_URL=http://localhost
# Nginx 对外端口
HTTP_PORT=80
