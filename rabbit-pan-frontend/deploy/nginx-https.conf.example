# ============================================================
# Rabbit 网盘 · HTTPS 站点配置样例（宿主机 Nginx，可选）
# 适用场景：前端容器只监听 127.0.0.1:8081，由宿主机 Nginx 终止 TLS
# 证书：Let's Encrypt（certbot 自动续期）
# ============================================================

# HTTP -> HTTPS 跳转
server {
    listen 80;
    server_name pan.example.com;
    # certbot 续期验证
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name pan.example.com;

    # ---- 证书（certbot 签发路径） ----
    ssl_certificate     /etc/letsencrypt/live/pan.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pan.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;

    # ---- 安全响应头 ----
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;

    client_max_body_size 1024m;
    client_body_timeout 600s;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json;

    # 全部转发到前端容器（内部由容器 Nginx 分流 /api 与 /s）
    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_request_buffering off;
    }
}
